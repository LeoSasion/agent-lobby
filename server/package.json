{
  "name": "agent-lobby-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent 游戏大厅 · Arena Server 内核（BYOA：平台只提供赛场，选手由用户自带）",
  "scripts": {
    "smoke": "node --experimental-strip-types src/main.ts",
    "smoke:othello": "node --experimental-strip-types src/smoke-othello.ts",
    "smoke:werewolf": "node --experimental-strip-types src/smoke-werewolf.ts",
    "smoke:holdem": "node --experimental-strip-types src/smoke-holdem.ts",
    "smoke:dilemma": "node --experimental-strip-types src/smoke-dilemma.ts",
    "smoke:undercover": "node --experimental-strip-types src/smoke-undercover.ts",
    "smoke:llm": "node --experimental-strip-types src/smoke-commentary-llm.ts",
    "smoke:webhook": "node --experimental-strip-types src/smoke-webhook.ts",
    "smoke:framework": "node --experimental-strip-types src/smoke-framework.ts",
    "smoke:gap": "node --experimental-strip-types src/smoke-http-gap.ts",
    "smoke:room": "node --experimental-strip-types src/smoke-room.ts",
    "smoke:errors": "node --experimental-strip-types src/smoke-errors.ts",
    "smoke:persist": "node --experimental-strip-types src/smoke-persist.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run smoke && npm run smoke:othello && npm run smoke:werewolf && npm run smoke:holdem && npm run smoke:dilemma && npm run smoke:undercover && npm run smoke:llm && npm run smoke:framework && npm run smoke:gap && npm run smoke:room && npm run smoke:errors && npm run smoke:persist",
    "start": "node --experimental-strip-types src/server.ts",
    "play": "node --experimental-strip-types src/cli/play.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
